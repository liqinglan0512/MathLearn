","id":"euclid-1-def-10","book":1,"number":10,"kind":"definition","title":"直角与垂直线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-9:euclid-3-1:explicit","id":"euclid-3-1","book":3,"number":1,"kind":"proposition","title":"寻找给定圆的圆心","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-3-25:euclid-3-9:explicit","id":"euclid-3-25","book":3,"number":25,"kind":"proposition","title":"有圆之分求成圆","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-circle","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
