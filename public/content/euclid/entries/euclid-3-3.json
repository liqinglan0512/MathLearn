"number":14,"kind":"proposition","title":"圆中等弦到圆心的距离相等，反之亦然","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-35:euclid-3-3:explicit","id":"euclid-3-35","book":3,"number":35,"kind":"proposition","title":"相交弦定理","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-36:euclid-3-3:explicit","id":"euclid-3-36","book":3,"number":36,"kind":"proposition","title":"切割线定理","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-12-16:euclid-3-3:explicit","id":"euclid-12-16","book":12,"number":16,"kind":"proposition","title":"构造与求解：多边形与切线与圆","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-circle","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
