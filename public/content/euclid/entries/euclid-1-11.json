","sourceBlockIds":["euclid-1-11.proof.4"],"targetContentId":"euclid-1-def-10","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.11","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.11/","sourceLabel":"Def. 10"}}],"incomingEdges":[{"id":"edge:euclid-1-13:euclid-1-11:explicit","sourceContentId":"euclid-1-13","sourceBlockIds":["euclid-1-13.proof.3"],"targetContentId":"euclid-1-11","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.13","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.13/","sourceLabel":"I. 11"}},{"id":"edge:euclid-1-46:euclid-1-11:explicit","sourceContentId":"euclid-1-46","sourceBlockIds":["euclid-1-46.construction.2"],"targetContentId":"euclid-1-11","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.46","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.46/","sourceLabel":"I. 11"}},{"id":"edge:euclid-2-1:euclid-1-11:explicit","sourceContentId":"euclid-2-1","sourceBlockIds":["euclid-2-1.construction.2"],"targetContentId":"euclid-1-11","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:2.prop.1","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:2.prop.1/","sourceLabel":"I. 11"}},{"id":"edge:euclid-2-10:euclid-1-11:explicit","sourceContentId":"euclid-2-10","sourceBlockIds":["euclid-2-10.construction.2"],"targetContentId":"euclid-1-11","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:c