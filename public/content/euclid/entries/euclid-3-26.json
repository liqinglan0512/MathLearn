ok":4,"number":15,"kind":"proposition","title":"圆内接正六边形的尺规作图","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-10:euclid-3-26:explicit","id":"euclid-13-10","book":13,"number":10,"kind":"proposition","title":"等量关系：五边形与六边形与十边形","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-circle","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
