g2:9.prop.2/","sourceLabel":"VIII. 18"}}],"dependencies":[{"edgeId":"edge:euclid-8-18:euclid-7-def-21:explicit","id":"euclid-7-def-21","book":7,"number":21,"kind":"definition","title":"相似平面数与相似立体数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-8-18:euclid-7-13:explicit","id":"euclid-7-13","book":7,"number":13,"kind":"proposition","title":"性质与证明：比例与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-8-18:euclid-7-17:explicit","id":"euclid-7-17","book":7,"number":17,"kind":"proposition","title":"等量关系：比例与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-8-18:euclid-5-def-9:explicit","id":"euclid-5-def-9","book":5,"number":9,"kind":"definition","title":"重比：三项连比例中的平方比","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-8-19:euclid-8-18:explicit","id":"euclid-8-19","book":8,"number":19,"kind":"proposition","title":"性质与证明：比例与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-8-24:euclid-8-18:explicit","id":"euclid-8-24","book":8,"number":24,"kind":"proposition","title":"性质与证明：平方与比例与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-8-26:euclid-8-18:explicit","id":"euclid-8-26","book":8,"number":26,"kind":"proposition","title":"性质与证明：平面与平方与比例","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-1:euclid-8-18:explicit","id":"euclid-9-1","book":9,"number":1,"kind":"proposition","title":"性质与证明：平面与平方与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-2:euclid-8-18:explicit","id":"euclid-9-2","book":9,"number":2,"kind":"proposition","title":"性质与证明：平面与平方与整数","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-number","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
