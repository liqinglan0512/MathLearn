-3-1:explicit","id":"euclid-3-9","book":3,"number":9,"kind":"proposition","title":"圆内从一点至界作三线以上皆等即此点必圆心","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-10:euclid-3-1:explicit","id":"euclid-3-10","book":3,"number":10,"kind":"proposition","title":"两个圆至多相交于两点","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-14:euclid-3-1:explicit","id":"euclid-3-14","book":3,"number":14,"kind":"proposition","title":"圆中等弦到圆心的距离相等，反之亦然","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-17:euclid-3-1:explicit","id":"euclid-3-17","book":3,"number":17,"kind":"proposition","title":"过圆外一点作圆的切线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-4-3:euclid-3-1:explicit","id":"euclid-4-3","book":4,"number":3,"kind":"proposition","title":"在圆外作与给定三角形相似的外切三角形","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-4-12:euclid-3-1:explicit","id":"euclid-4-12","book":4,"number":12,"kind":"proposition","title":"有圆求作圆外五边切形其形等边等角","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-13:euclid-3-1:explicit","id":"euclid-13-13","book":13,"number":13,"kind":"proposition","title":"作内接于球的正四面体","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-circle","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
