{"schemaVersion":1,"corpusId":"euclid-elements-heath-1908","status":"raw_machine","contentItem":{"id":"euclid-9-25","kind":"proposition","title":"性质与证明：整数","englishTitle":"If from an even number an odd number be subtracted, the remainder will be odd.","book":9,"number":25,"status":"raw_machine","sourceMissing":false,"source":{"urn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25","url":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25/","group":"prop","sourceNumber":25,"corpusSha256":"ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c","hasSourceFigure":true,"historicalChineseUrl":null}},"revision":{"id":"euclid-9-25@raw-181b72d6fa793691","contentId":"euclid-9-25","version":1,"status":"raw_machine","contentHash":"181b72d6fa793691b2a5e9c4321fa61089eabdfc95a04dff4688bebf8acb91b0","createdBy":"mathforge-corpus-import","changeSummary":"Imported Heath source and machine-assisted Chinese draft. No mathematical or editorial review is implied.","blockIds":["euclid-9-25.statement","euclid-9-25.proof.1","euclid-9-25.construction.1","euclid-9-25.proof.2","euclid-9-25.conclusion","euclid-9-25.source"]},"blocks":[{"id":"euclid-9-25.statement","contentId":"euclid-9-25","revisionId":"euclid-9-25@raw-181b72d6fa793691","order":0,"kind":"statement","title":"命题陈述","status":"raw_machine","contentHash":"2805217e93c2de119456478cebacc52fef9703c757724e55dd5f97f1e3464740","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"If from an even number an odd number be subtracted, the remainder will be odd."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"如果从偶数中减去一个奇数,则其余的则奇数。"}]},{"id":"euclid-9-25.proof.1","contentId":"euclid-9-25","revisionId":"euclid-9-25@raw-181b72d6fa793691","order":1,"kind":"proof_step","title":"证明 1","status":"raw_machine","contentHash":"5f0544df02d9813b9b503d75b225e29ff008dcacf8241f0abae5e2d53d52c691","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"For from the even number AB let the odd number BC be subtracted; I say that the remainder CA is odd."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"将AB数字中的奇数BC减掉;我说其余的CA是奇数。"}]},{"id":"euclid-9-25.construction.1","contentId":"euclid-9-25","revisionId":"euclid-9-25@raw-181b72d6fa793691","order":2,"kind":"construction","title":"作图与构造 1","status":"raw_machine","contentHash":"7e5d26afc308cc31b5550dee929e874fa59afa91fed1ce2f13f2f4fdee65b1c3","citations":["euclid-7-def-7"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"For let the unit CD be subtracted from BC; therefore DB is even. [[VII. Def. 7](/principles/euclid-7-def-7)]"},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"将单位 CD从BC中减去,因此DB是平的。 [[VII. Def. 7](/principles/euclid-7-def-7)]"}]},{"id":"euclid-9-25.proof.2","contentId":"euclid-9-25","revisionId":"euclid-9-25@raw-181b72d6fa793691","order":3,"kind":"proof_step","title":"证明 2","status":"raw_machine","contentHash":"f02e6fada2cf9b06d570df00c94b1e8c2b527074081b6218187991ffb6cadf16","citations":["euclid-9-24"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"But AB is also even; therefore the remainder AD is also even. [[IX. 24](/principles/euclid-9-24)]"},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"但AB也是公平的;因此,其余的AD也是公平的。 [[IX. 24](/principles/euclid-9-24)]"}]},{"id":"euclid-9-25.conclusion","contentId":"euclid-9-25","revisionId":"euclid-9-25@raw-181b72d6fa793691","order":4,"kind":"conclusion","title":"结论","status":"raw_machine","contentHash":"49a1e3f89086cd83355495572ff54eba160d1c5b4b8236dd32a85aafcb5b2072","citations":["euclid-7-def-7"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"And CD is an unit; therefore CA is odd. [[VII. Def. 7](/principles/euclid-7-def-7)] Q. E. D."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"CD是单位,CA是奇数 证毕。 [[VII. Def. 7](/principles/euclid-7-def-7)]"}]},{"id":"euclid-9-25.source","contentId":"euclid-9-25","revisionId":"euclid-9-25@raw-181b72d6fa793691","order":5,"kind":"source","title":"来源、译者与开放许可","status":"raw_machine","contentHash":"278119a04d8843e9f3cda9f5a3adc2b9414ca8f51f62ff3b41f07c3b22ba53f9","citations":[],"surfaces":[{"id":"provenance","role":"provenance_note","language":"en","status":"generated_metadata","text":"Perseus / Heath source: https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25/\nCorpus URN: urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25\nCorpus SHA-256: ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c\nLicense: CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/)"}]}],"outgoingEdges":[{"id":"edge:euclid-9-25:euclid-7-def-7:explicit","sourceContentId":"euclid-9-25","sourceBlockIds":["euclid-9-25.construction.1","euclid-9-25.conclusion"],"targetContentId":"euclid-7-def-7","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25/","sourceLabel":"VII. Def. 7"}},{"id":"edge:euclid-9-25:euclid-9-24:explicit","sourceContentId":"euclid-9-25","sourceBlockIds":["euclid-9-25.proof.2"],"targetContentId":"euclid-9-24","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.25/","sourceLabel":"IX. 24"}}],"incomingEdges":[],"dependencies":[{"edgeId":"edge:euclid-9-25:euclid-7-def-7:explicit","id":"euclid-7-def-7","book":7,"number":7,"kind":"definition","title":"奇数：不能分成两个相等部分的整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-25:euclid-9-24:explicit","id":"euclid-9-24","book":9,"number":24,"kind":"proposition","title":"性质与证明：整数","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-number","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
