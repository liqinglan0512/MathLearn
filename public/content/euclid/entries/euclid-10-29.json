29","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.29/","sourceLabel":"I. 47"}}],"incomingEdges":[{"id":"edge:euclid-10-31:euclid-10-29:explicit","sourceContentId":"euclid-10-31","sourceBlockIds":["euclid-10-31.construction.1"],"targetContentId":"euclid-10-29","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.31","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.31/","sourceLabel":"X. 29"}},{"id":"edge:euclid-10-32:euclid-10-29:explicit","sourceContentId":"euclid-10-32","sourceBlockIds":["euclid-10-32.construction.1"],"targetContentId":"euclid-10-29","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.32","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.32/","sourceLabel":"X. 29"}}],"dependencies":[{"edgeId":"edge:euclid-10-29:euclid-10-28:explicit","id":"euclid-10-28","book":10,"number":28,"kind":"proposition","title":"构造与求解：可公度量与中项无理线段与平方","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-29:euclid-10-6:explicit","id":"euclid-10-6","book":10,"number":6,"kind":"proposition","title":"性质与证明：可公度量与比例与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-29:euclid-10-def-4:explicit","id":"euclid-10-def-4","book":10,"number":4,"kind":"definition","title":"有理面积、无理面积及其对应线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-29:euclid-10-9:explicit","id":"euclid-10-9","book":10,"number":9,"kind":"proposition","title":"长度可公度与平方数比例","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-29:euclid-5-19:explicit","id":"euclid-5-19","book":5,"number":19,"kind":"proposition","title":"性质与证明：比例论","provenance":"explicit_source_reference"},{"