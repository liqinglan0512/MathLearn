{"schemaVersion":1,"corpusId":"euclid-elements-heath-1908","status":"raw_machine","contentItem":{"id":"euclid-8-7","kind":"proposition","title":"性质与证明：连比例与比例与整数","englishTitle":"If there be as many numbers as we please in continued proportion, and the first measure the last, it will measure the second also.","book":8,"number":7,"status":"raw_machine","sourceMissing":false,"source":{"urn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.7","url":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.7/","group":"prop","sourceNumber":7,"corpusSha256":"ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c","hasSourceFigure":true,"historicalChineseUrl":null}},"revision":{"id":"euclid-8-7@raw-52bcc895d22df6ed","contentId":"euclid-8-7","version":1,"status":"raw_machine","contentHash":"52bcc895d22df6ed4d5ce9dffe22501417fa31d80d53a1c7b9f8d2c6591bd665","createdBy":"mathforge-corpus-import","changeSummary":"Imported Heath source and machine-assisted Chinese draft. No mathematical or editorial review is implied.","blockIds":["euclid-8-7.statement","euclid-8-7.construction.1","euclid-8-7.proof.1","euclid-8-7.proof.2","euclid-8-7.conclusion","euclid-8-7.source"]},"blocks":[{"id":"euclid-8-7.statement","contentId":"euclid-8-7","revisionId":"euclid-8-7@raw-52bcc895d22df6ed","order":0,"kind":"statement","title":"命题陈述","status":"raw_machine","contentHash":"c45cbd025186125e2f4af3de59260fefb61615accdfc80b92d559f2d22f2853a","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"If there be as many numbers as we please in continued proportion, and the first measure the last, it will measure the second also."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"如果连比例有我们想要的多少数字, 而前整除的最后一个数字, 也会有整除的第二个数字。"}]},{"id":"euclid-8-7.construction.1","contentId":"euclid-8-7","revisionId":"euclid-8-7@raw-52bcc895d22df6ed","order":1,"kind":"construction","title":"作图与构造 1","status":"raw_machine","contentHash":"641a21f4660a4b2120bcedf939627d4393211c8280a7065a25fbae2e513223e8","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Let there be as many numbers as we please, A, B, C, D, in continued proportion; and let A measure D; I say that A also measures B."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"让我们想多少就多少,连比例A,B,C,D;A,整除,D;我说A,整除,B。"}]},{"id":"euclid-8-7.proof.1","contentId":"euclid-8-7","revisionId":"euclid-8-7@raw-52bcc895d22df6ed","order":2,"kind":"proof_step","title":"证明 1","status":"raw_machine","contentHash":"4a86d376703a9ee9818dcac2603a62e841e364eeeb6779de8b3663344141b86a","citations":["euclid-8-6"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"For, if A does not measure B, neither will any other of the numbers measure any other. [[VIII. 6](/principles/euclid-8-6)]"},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"因为,如果A不是整除 B, 整除中的任何其他人也不会有其他的。 [[VIII. 6](/principles/euclid-8-6)]"}]},{"id":"euclid-8-7.proof.2","contentId":"euclid-8-7","revisionId":"euclid-8-7@raw-52bcc895d22df6ed","order":3,"kind":"proof_step","title":"证明 2","status":"raw_machine","contentHash":"453f05879ec4fd8cba45848bdebd89966f5a37b8367322be7063d2fe354fbe85","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"But A measures D."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"A 整除 D"}]},{"id":"euclid-8-7.conclusion","contentId":"euclid-8-7","revisionId":"euclid-8-7@raw-52bcc895d22df6ed","order":4,"kind":"conclusion","title":"结论","status":"raw_machine","contentHash":"ea7d3a8cc695a46386b578cfce5e4e8e5d0eb8cd351f1e7ae1ee8b6272d6f6a1","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Therefore A also measures B. Q. E. D."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"因此,A也是整除 B,证毕。"}]},{"id":"euclid-8-7.source","contentId":"euclid-8-7","revisionId":"euclid-8-7@raw-52bcc895d22df6ed","order":5,"kind":"source","title":"来源、译者与开放许可","status":"raw_machine","contentHash":"e711bc8849982b2e177e5e7f7f147efbf6521212b4f31c2c88526a21c2e176d0","citations":[],"surfaces":[{"id":"provenance","role":"provenance_note","language":"en","status":"generated_metadata","text":"Perseus / Heath source: https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.7/\nCorpus URN: urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.7\nCorpus SHA-256: ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c\nLicense: CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/)"}]}],"outgoingEdges":[{"id":"edge:euclid-8-7:euclid-8-6:explicit","sourceContentId":"euclid-8-7","sourceBlockIds":["euclid-8-7.proof.1"],"targetContentId":"euclid-8-6","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.7","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.7/","sourceLabel":"VIII. 6"}}],"incomingEdges":[{"id":"edge:euclid-8-14:euclid-8-7:explicit","sourceContentId":"euclid-8-14","sourceBlockIds":["euclid-8-14.proof.1"],"targetContentId":"euclid-8-7","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.14","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:8.prop.14/","sourceLabel":"VIII. 7"}},{"id":"edge:euclid-8-15:euclid-8-7:explicit","sourceContentId":"euclid-8-15","sourceBlockIds":["euclid-8-15.proof.2"],"targetContentId":"euclid-8-7","type":"depends_o