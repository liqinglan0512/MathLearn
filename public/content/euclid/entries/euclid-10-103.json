0.prop_3.103/","sourceLabel":"X. 14"}},{"id":"edge:euclid-10-103:euclid-10-12:explicit","sourceContentId":"euclid-10-103","sourceBlockIds":["euclid-10-103.proof.8","euclid-10-103.proof.10"],"targetContentId":"euclid-10-12","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.103","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.103/","sourceLabel":"X. 12"}}],"incomingEdges":[],"dependencies":[{"edgeId":"edge:euclid-10-103:euclid-10-73:explicit","id":"euclid-10-73","book":10,"number":73,"kind":"proposition","title":"性质与证明：可公度量与截差无理线段与无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-6-12:explicit","id":"euclid-6-12","book":6,"number":12,"kind":"proposition","title":"三直线求别作一线相与为断比例","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-5-12:explicit","id":"euclid-5-12","book":5,"number":12,"kind":"proposition","title":"性质与证明：比例与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-10-11:explicit","id":"euclid-10-11","book":10,"number":11,"kind":"proposition","title":"比例关系保持可公度与不可公度","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-10-13:explicit","id":"euclid-10-13","book":10,"number":13,"kind":"proposition","title":"性质与证明：不可公度量与可公度量","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-5-16:explicit","id":"euclid-5-16","book":5,"number":16,"kind":"proposition","title":"比例的交错变换","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-10-14:explicit","id":"euclid-10-14","book":10,"number":14,"kind":"proposition","title":"大小比较：可公度量与平方与比例","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-103:euclid-10-12:explicit","id":"euclid-10-12","book":10,"number":12,"kind":"proposition","title":"性质与证明：可公度量","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-irrational","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
