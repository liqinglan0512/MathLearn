"},{"edgeId":"edge:euclid-12-17:euclid-1-33:explicit","id":"euclid-12-17","book":12,"number":17,"kind":"proposition","title":"构造与求解：球与切线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-16:euclid-1-33:explicit","id":"euclid-13-16","book":13,"number":16,"kind":"proposition","title":"作内接于球的正二十面体","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-parallel","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
