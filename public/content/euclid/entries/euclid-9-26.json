7-def-7","book":7,"number":7,"kind":"definition","title":"奇数：不能分成两个相等部分的整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-26:euclid-9-24:explicit","id":"euclid-9-24","book":9,"number":24,"kind":"proposition","title":"性质与证明：整数","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-10-28:euclid-9-26:explicit","id":"euclid-10-28","book":10,"number":28,"kind":"proposition","title":"构造与求解：可公度量与中项无理线段与平方","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-number","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
