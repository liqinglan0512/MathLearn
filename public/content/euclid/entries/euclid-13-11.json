it","id":"euclid-10-73","book":10,"number":73,"kind":"proposition","title":"性质与证明：可公度量与截差无理线段与无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-11:euclid-10-15:explicit","id":"euclid-10-15","book":10,"number":15,"kind":"proposition","title":"性质与证明：可公度量","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-11:euclid-10-12:explicit","id":"euclid-10-12","book":10,"number":12,"kind":"proposition","title":"性质与证明：可公度量","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-11:euclid-5-19:explicit","id":"euclid-5-19","book":5,"number":19,"kind":"proposition","title":"性质与证明：比例论","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-11:euclid-10-def-14:explicit","id":"euclid-10-def-14","book":10,"number":14,"kind":"definition","title":"第四类截差无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-13-11:euclid-10-94:explicit","id":"euclid-10-94","book":10,"number":94,"kind":"proposition","title":"性质与证明：截差无理线段与比例与线段","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-13-16:euclid-13-11:explicit","id":"euclid-13-16","book":13,"number":16,"kind":"proposition","title":"作内接于球的正二十面体","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-polygon","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
