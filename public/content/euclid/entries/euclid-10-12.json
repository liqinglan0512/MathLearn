/","sourceLabel":"V. 22"}},{"id":"edge:euclid-10-12:euclid-10-6:explicit","sourceContentId":"euclid-10-12","sourceBlockIds":["euclid-10-12.proof.7"],"targetContentId":"euclid-10-6","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.12","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.12/","sourceLabel":"X. 6"}}],"incomingEdges":[{"id":"edge:euclid-10-13:euclid-10-12:explicit","sourceContentId":"euclid-10-13","sourceBlockIds":["euclid-10-13.proof.1"],"targetContentId":"euclid-10-12","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.13","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.13/","sourceLabel":"X. 12"}},{"id":"edge:euclid-10-17:euclid-10-12:explicit","sourceContentId":"euclid-10-17","sourceBlockIds":["euclid-10-17.proof.11","euclid-10-17.proof.17"],"targetContentId":"euclid-10-12","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.17","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.17/","sourceLabel":"X. 12"}},{"id":"edge:euclid-10-54:euclid-10-12:explicit","sourceContentId":"euclid-10-54","sourceBlockIds":["euclid-10-54.proof.11"],"targetContentId":"euclid-10-12","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_2.54","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_2.54/","sourceLabel":"X. 12"}},{"id":"edge:euclid-10-55:euclid-10-12:explicit","sourceContentId":"euclid-10-55","sourceBlockIds":["euclid-10-55.pro