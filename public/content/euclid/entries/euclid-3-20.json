/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:3.prop.21/","sourceLabel":"III. 20"}},{"id":"edge:euclid-3-27:euclid-3-20:explicit","sourceContentId":"euclid-3-27","sourceBlockIds":["euclid-3-27.proof.6"],"targetContentId":"euclid-3-20","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:3.prop.27","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:3.prop.27/","sourceLabel":"III. 20"}}],"dependencies":[{"edgeId":"edge:euclid-3-20:euclid-1-5:explicit","id":"euclid-1-5","book":1,"number":5,"kind":"proposition","title":"等腰三角形：等边对等角","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-20:euclid-1-32:explicit","id":"euclid-1-32","book":1,"number":32,"kind":"proposition","title":"三角形内角和与外角定理","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-3-21:euclid-3-20:explicit","id":"euclid-3-21","book":3,"number":21,"kind":"proposition","title":"同弧所对圆周角相等","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-3-27:euclid-3-20:explicit","id":"euclid-3-27","book":3,"number":27,"kind":"proposition","title":"等圆之角所乘圆分等则其角或在心或在界俱等","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-circle","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
