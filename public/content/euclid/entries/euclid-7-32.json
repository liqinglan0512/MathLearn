{"schemaVersion":1,"corpusId":"euclid-elements-heath-1908","status":"raw_machine","contentItem":{"id":"euclid-7-32","kind":"proposition","title":"每个整数要么是素数，要么有素因子","englishTitle":"Any number either is prime or is measured by some prime number.","book":7,"number":32,"status":"raw_machine","sourceMissing":false,"source":{"urn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:7.prop.32","url":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:7.prop.32/","group":"prop","sourceNumber":32,"corpusSha256":"ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c","hasSourceFigure":true,"historicalChineseUrl":null}},"revision":{"id":"euclid-7-32@raw-bd128767da3fc5b7","contentId":"euclid-7-32","version":1,"status":"raw_machine","contentHash":"bd128767da3fc5b73f6cd0284f2788714d854584eade29e59124efbd7738aff4","createdBy":"mathforge-corpus-import","changeSummary":"Imported Heath source and machine-assisted Chinese draft. No mathematical or editorial review is implied.","blockIds":["euclid-7-32.statement","euclid-7-32.construction.1","euclid-7-32.proof.1","euclid-7-32.proof.2","euclid-7-32.conclusion","euclid-7-32.source"]},"blocks":[{"id":"euclid-7-32.statement","contentId":"euclid-7-32","revisionId":"euclid-7-32@raw-bd128767da3fc5b7","order":0,"kind":"statement","title":"命题陈述","status":"raw_machine","contentHash":"4a5dbaacfb44690caebf7b894e53acff75818e72e8a320d6d0701d3ad66aed80","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Any number either is prime or is measured by some prime number."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"任何数字要么是正数,要么是素数左右。"}]},{"id":"euclid-7-32.construction.1","contentId":"euclid-7-32","revisionId":"euclid-7-32@raw-bd128767da3fc5b7","order":1,"kind":"construction","title":"作图与构造 1","status":"raw_machine","contentHash":"a792d96f3812857119dfb08f419331252646ae977267f6487f0d0a4b30445c95","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Let A be a number; I say that A either is prime or is measured by some prime number."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"让我们把A变成一个数字;我说A要么是质数,要么是素数左右。"}]},{"id":"euclid-7-32.proof.1","contentId":"euclid-7-32","revisionId":"euclid-7-32@raw-bd128767da3fc5b7","order":2,"kind":"proof_step","title":"证明 1","status":"raw_machine","contentHash":"fdfbcaf382af0f21b36fdcb3c6cb5adffefba8d1c94b67dae989f3693fade3cd","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"If now A is prime, that which was enjoined will have been done."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"如果现在A是最重要的,那么,我们所奉命完成的任务就已经完成了。"}]},{"id":"euclid-7-32.proof.2","contentId":"euclid-7-32","revisionId":"euclid-7-32@raw-bd128767da3fc5b7","order":3,"kind":"proof_step","title":"证明 2","status":"raw_machine","contentHash":"1217b06d039bad5c1f128ee5c19bd24bdbd44219ab84c30521045d4931c5ec3b","citations":["euclid-7-31"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"But if it is composite, some prime number will measure it. [[VII. 31](/principles/euclid-7-31)]"},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"但如果是复合的,大约素数会整除它。 [[VII. 31](/principles/euclid-7-31)]"}]},{"id":"euclid-7-32.conclusion","contentId":"euclid-7-32","revisionId":"euclid-7-32@raw-bd128767da3fc5b7","order":4,"kind":"conclusion","title":"结论","status":"raw_machine","contentHash":"1bd0870f0108b6d881d69d748e043f3675121c36a401613a525a77255f95379b","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Therefore any number either is prime or is measured by some prime number. Q. E. D."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"因此,任何数字要么是正数,要么是约素数,Q,E。"}]},{"id":"euclid-7-32.source","contentId":"euclid-7-32","revisionId":"euclid-7-32@raw-bd128767da3fc5b7","order":5,"kind":"source","title":"来源、译者与开放许可","status":"raw_machine","contentHash":"3bf26c444a7ba2a7c329c28ea03fe8338277cc87b00517301868d8618c992fba","citations":[],"surfaces":[{"id":"provenance","role":"provenance_note","language":"en","status":"generated_metadata","text":"Perseus / Heath source: https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:7.prop.32/\nCorpus URN: urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:7.prop.32\nCorpus SHA-256: ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c\nLicense: CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/)"}]}],"outgoingEdges":[{"id":"edge:euclid-7-32:euclid-7-31:explicit","sourceContentId":"euclid-7-32","sourceBlockIds":["euclid-7-32.proof.2"],"targetContentId":"euclid-7-31","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:7.prop.32","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:7.prop.32/","sourceLabel":"VII. 31"}}],"incomingEdges":[],"dependencies":[{"edgeId":"edge:euclid-7-32:euclid-7-31:explicit","id":"euclid-7-31","book":7,"number":31,"kind":"proposition","title":"合数一定有素因子","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-number","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
