tlg001.perseus-eng2:10.prop_3.95/","sourceLabel":"VI. 26"}},{"id":"edge:euclid-10-95:euclid-10-77:explicit","sourceContentId":"euclid-10-95","sourceBlockIds":["euclid-10-95.proof.10"],"targetContentId":"euclid-10-77","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.95","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.95/","sourceLabel":"X. 77"}}],"incomingEdges":[{"id":"edge:euclid-10-109:euclid-10-95:explicit","sourceContentId":"euclid-10-109","sourceBlockIds":["euclid-10-109.proof.7"],"targetContentId":"euclid-10-95","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.109","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.109/","sourceLabel":"X. 95"}}],"dependencies":[{"edgeId":"edge:euclid-10-95:euclid-10-def-15:explicit","id":"euclid-10-def-15","book":10,"number":15,"kind":"definition","title":"第五类截差无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-95:euclid-10-18:explicit","id":"euclid-10-18","book":10,"number":18,"kind":"proposition","title":"等量关系：不可公度量与可公度量与平行四边形","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-95:euclid-10-21:explicit","id":"euclid-10-21","book":10,"number":21,"kind":"proposition","title":"等量关系：可公度量与中项无理线段与无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-95:euclid-10-19:explicit","id":"euclid-10-19","book":10,"number":19,"kind":"proposition","title":"性质与证明：可公度量与比例与角","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-95:euclid-6-26:explicit","id":"euclid-6-26","book":6,"number":26,"kind":"proposition","title":"平行方形的内减一平行方形其减形与元形相似而体势等又一角同则减形必依元形的对…","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-95:euclid-10-77:e