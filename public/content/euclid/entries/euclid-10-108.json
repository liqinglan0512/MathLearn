:tlg1799.tlg001.perseus-eng2:10.prop_3.108/","sourceLabel":"X. Deff. III. 1"}},{"id":"edge:euclid-10-108:euclid-10-91:explicit","sourceContentId":"euclid-10-108","sourceBlockIds":["euclid-10-108.proof.8"],"targetContentId":"euclid-10-91","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.108","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.108/","sourceLabel":"X. 91"}},{"id":"edge:euclid-10-108:euclid-10-def-14:explicit","sourceContentId":"euclid-10-108","sourceBlockIds":["euclid-10-108.proof.10"],"targetContentId":"euclid-10-def-14","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.108","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.108/","sourceLabel":"X. Deff. III. 4"}},{"id":"edge:euclid-10-108:euclid-10-94:explicit","sourceContentId":"euclid-10-108","sourceBlockIds":["euclid-10-108.conclusion"],"targetContentId":"euclid-10-94","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.108","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_3.108/","sourceLabel":"X. 94"}}],"incomingEdges":[],"dependencies":[{"edgeId":"edge:euclid-10-108:euclid-10-20:explicit","id":"euclid-10-20","book":10,"number":20,"kind":"proposition","title":"性质与证明：可公度量与比例与线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-108:euclid-10-22:explicit","id":"euclid-10-22","book":10,"number":22,"kind":"proposition","title":"性质与证明：不可公度量与可公度量与中项无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-108:euclid-10-13:explicit","id":"euclid-10-13","book":10,"number":13,"kind":"propos