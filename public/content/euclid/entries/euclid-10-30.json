30/","sourceLabel":"I. 47"}},{"id":"edge:euclid-10-30:euclid-10-9:explicit","sourceContentId":"euclid-10-30","sourceBlockIds":["euclid-10-30.proof.3"],"targetContentId":"euclid-10-9","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.30","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.30/","sourceLabel":"X. 9"}}],"incomingEdges":[{"id":"edge:euclid-10-31:euclid-10-30:explicit","sourceContentId":"euclid-10-31","sourceBlockIds":["euclid-10-31.proof.10"],"targetContentId":"euclid-10-30","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.31","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.31/","sourceLabel":"X. 30"}},{"id":"edge:euclid-10-32:euclid-10-30:explicit","sourceContentId":"euclid-10-32","sourceBlockIds":["euclid-10-32.proof.10"],"targetContentId":"euclid-10-30","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.32","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.32/","sourceLabel":"X. 30"}},{"id":"edge:euclid-10-33:euclid-10-30:explicit","sourceContentId":"euclid-10-33","sourceBlockIds":["euclid-10-33.construction.1"],"targetContentId":"euclid-10-30","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.33","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_1.33/","sourceLabel":"X. 30"}}],"dependencies":[{"edgeId":"edge:euclid-10-30:euclid-10-28:explicit","id":"euclid-10-28","book":10,"number":28,"kind":"proposition"