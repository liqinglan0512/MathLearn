{"schemaVersion":1,"corpusId":"euclid-elements-heath-1908","status":"raw_machine","contentItem":{"id":"euclid-10-def-13","kind":"definition","title":"第三类截差无理线段","englishTitle":"But if neither be commensurable in length with the rational straight line set out, and the square on the whole be greater than the square on the annex by the square on a straight line commensurable with the whole, let the apotome be called a third apotome.","book":10,"number":13,"status":"raw_machine","sourceMissing":false,"source":{"urn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.def_3.3","url":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.def_3.3/","group":"def_3","sourceNumber":3,"corpusSha256":"ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c","hasSourceFigure":false,"historicalChineseUrl":null}},"revision":{"id":"euclid-10-def-13@raw-e18c7969cf60837b","contentId":"euclid-10-def-13","version":1,"status":"raw_machine","contentHash":"e18c7969cf60837bb33ac4f63413dcc67503a482cb184031555716747c1dd21a","createdBy":"mathforge-corpus-import","changeSummary":"Imported Heath source and machine-assisted Chinese draft. No mathematical or editorial review is implied.","blockIds":["euclid-10-def-13.statement","euclid-10-def-13.source"]},"blocks":[{"id":"euclid-10-def-13.statement","contentId":"euclid-10-def-13","revisionId":"euclid-10-def-13@raw-e18c7969cf60837b","order":0,"kind":"definition","title":"定义陈述","status":"raw_machine","contentHash":"d760b144661479b40be273ffd59c545104e58e0c265c165a036a31bc91060f15","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"But if neither be commensurable in length with the rational straight line set out, and the square on the whole be greater than the square on the annex by the square on a straight line commensurable with the whole, let the apotome be called a third apotome."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","