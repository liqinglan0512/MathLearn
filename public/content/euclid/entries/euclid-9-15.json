d":"edge:euclid-9-15:euclid-7-22:explicit","id":"euclid-7-22","book":7,"number":22,"kind":"proposition","title":"等量关系：最小公倍数与素数与互素与比例","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-15:euclid-7-28:explicit","id":"euclid-7-28","book":7,"number":28,"kind":"proposition","title":"性质与证明：素数与互素与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-15:euclid-7-24:explicit","id":"euclid-7-24","book":7,"number":24,"kind":"proposition","title":"性质与证明：整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-15:euclid-7-25:explicit","id":"euclid-7-25","book":7,"number":25,"kind":"proposition","title":"性质与证明：素数与互素与整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-15:euclid-2-3:explicit","id":"euclid-2-3","book":2,"number":3,"kind":"proposition","title":"线段分割与矩形面积分解","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-15:euclid-2-4:explicit","id":"euclid-2-4","book":2,"number":4,"kind":"proposition","title":"完全平方公式的几何证明","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-number","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
