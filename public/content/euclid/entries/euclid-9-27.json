{"schemaVersion":1,"corpusId":"euclid-elements-heath-1908","status":"raw_machine","contentItem":{"id":"euclid-9-27","kind":"proposition","title":"性质与证明：整数","englishTitle":"If from an odd number an even number be subtracted, the remainder will be odd.","book":9,"number":27,"status":"raw_machine","sourceMissing":false,"source":{"urn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27","url":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27/","group":"prop","sourceNumber":27,"corpusSha256":"ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c","hasSourceFigure":true,"historicalChineseUrl":null}},"revision":{"id":"euclid-9-27@raw-c910165d367c0f33","contentId":"euclid-9-27","version":1,"status":"raw_machine","contentHash":"c910165d367c0f33f68187bdd6c39e0699f97c3a37102f1cc406e0093e36ca44","createdBy":"mathforge-corpus-import","changeSummary":"Imported Heath source and machine-assisted Chinese draft. No mathematical or editorial review is implied.","blockIds":["euclid-9-27.statement","euclid-9-27.proof.1","euclid-9-27.construction.1","euclid-9-27.proof.2","euclid-9-27.conclusion","euclid-9-27.source"]},"blocks":[{"id":"euclid-9-27.statement","contentId":"euclid-9-27","revisionId":"euclid-9-27@raw-c910165d367c0f33","order":0,"kind":"statement","title":"命题陈述","status":"raw_machine","contentHash":"440a3fa9d345a278d611e04d1bd7aa04ea9e6bcc6796d6d777f8dec2b9ebaf29","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"If from an odd number an even number be subtracted, the remainder will be odd."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"如果从奇数中减去偶数,则其余的则为奇数。"}]},{"id":"euclid-9-27.proof.1","contentId":"euclid-9-27","revisionId":"euclid-9-27@raw-c910165d367c0f33","order":1,"kind":"proof_step","title":"证明 1","status":"raw_machine","contentHash":"f85d20f9fe764eb2dc536a23e4882a5286f1ed2243f6a088278983f42fe0a68b","citations":[],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"For from the odd number AB let the even number BC be subtracted; I say that the remainder CA is odd."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"以AB奇数计算,将BC偶数减去;我说其余的CA奇数。"}]},{"id":"euclid-9-27.construction.1","contentId":"euclid-9-27","revisionId":"euclid-9-27@raw-c910165d367c0f33","order":2,"kind":"construction","title":"作图与构造 1","status":"raw_machine","contentHash":"ba168dc985b1045786c6ecc075deafd815704cd19287a7e9430127a870d8e909","citations":["euclid-7-def-7"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Let the unit AD be subtracted; therefore DB is even. [[VII. Def. 7](/principles/euclid-7-def-7)]"},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"减去单位 AD,因此DB是平的。 [[VII. Def. 7](/principles/euclid-7-def-7)]"}]},{"id":"euclid-9-27.proof.2","contentId":"euclid-9-27","revisionId":"euclid-9-27@raw-c910165d367c0f33","order":3,"kind":"proof_step","title":"证明 2","status":"raw_machine","contentHash":"07d3fc834e40b9de67ef6f9318fad3588b03701b3a6c1bf44843d84bf94d080d","citations":["euclid-9-24"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"But BC is also even; therefore the remainder CD is even. [[IX. 24](/principles/euclid-9-24)]"},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"但BC也是公平的;因此,其余的CD也是公平的。 [[IX. 24](/principles/euclid-9-24)]"}]},{"id":"euclid-9-27.conclusion","contentId":"euclid-9-27","revisionId":"euclid-9-27@raw-c910165d367c0f33","order":4,"kind":"conclusion","title":"结论","status":"raw_machine","contentHash":"830f3ea6f20d6baa367e147d1b406a02a064ddfc0ac6dbb91da4c8417f2618e3","citations":["euclid-7-def-7"],"surfaces":[{"id":"heath-en","role":"source","language":"en","status":"source_transcription","text":"Therefore CA is odd. [[VII. Def. 7](/principles/euclid-7-def-7)] Q. E. D."},{"id":"machine-zh","role":"machine_translation","language":"zh-CN","status":"raw_machine","text":"所以CA是奇数 证毕。 [[VII. Def. 7](/principles/euclid-7-def-7)]"}]},{"id":"euclid-9-27.source","contentId":"euclid-9-27","revisionId":"euclid-9-27@raw-c910165d367c0f33","order":5,"kind":"source","title":"来源、译者与开放许可","status":"raw_machine","contentHash":"a94dba45c36f5f5c8d34cf632618202eb9a08efdd0983cd5b969fd98291b5187","citations":[],"surfaces":[{"id":"provenance","role":"provenance_note","language":"en","status":"generated_metadata","text":"Perseus / Heath source: https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27/\nCorpus URN: urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27\nCorpus SHA-256: ba12e2e47aec41f853ff32929a2d0467926f93280f1bf8870bda5016c29d143c\nLicense: CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/)"}]}],"outgoingEdges":[{"id":"edge:euclid-9-27:euclid-7-def-7:explicit","sourceContentId":"euclid-9-27","sourceBlockIds":["euclid-9-27.construction.1","euclid-9-27.conclusion"],"targetContentId":"euclid-7-def-7","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27/","sourceLabel":"VII. Def. 7"}},{"id":"edge:euclid-9-27:euclid-9-24:explicit","sourceContentId":"euclid-9-27","sourceBlockIds":["euclid-9-27.proof.2"],"targetContentId":"euclid-9-24","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:9.prop.27/","sourceLabel":"IX. 24"}}],"incomingEdges":[],"dependencies":[{"edgeId":"edge:euclid-9-27:euclid-7-def-7:explicit","id":"euclid-7-def-7","book":7,"number":7,"kind":"definition","title":"奇数：不能分成两个相等部分的整数","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-9-27:euclid-9-24:explicit","id":"euclid-9-24","book":9,"number":24,"kind":"proposition","title":"性质与证明：整数","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-number","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
