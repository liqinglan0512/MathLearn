.prop.35/","sourceLabel":"I. 26"}},{"id":"edge:euclid-11-35:euclid-1-4:explicit","sourceContentId":"euclid-11-35","sourceBlockIds":["euclid-11-35.proof.13","euclid-11-35.proof.19"],"targetContentId":"euclid-1-4","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:11.prop.35","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:11.prop.35/","sourceLabel":"I. 4"}},{"id":"edge:euclid-11-35:euclid-1-8:explicit","sourceContentId":"euclid-11-35","sourceBlockIds":["euclid-11-35.proof.22"],"targetContentId":"euclid-1-8","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:11.prop.35","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:11.prop.35/","sourceLabel":"I. 8"}}],"incomingEdges":[{"id":"edge:euclid-11-36:euclid-11-35:explicit","sourceContentId":"euclid-11-36","sourceBlockIds":["euclid-11-36.proof.3"],"targetContentId":"euclid-11-35","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:11.prop.36","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:11.prop.36/","sourceLabel":"XI. 35"}}],"dependencies":[{"edgeId":"edge:euclid-11-35:euclid-11-8:explicit","id":"euclid-11-8","book":11,"number":8,"kind":"proposition","title":"性质与证明：平面与平行线与角","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-11-35:euclid-1-47:explicit","id":"euclid-1-47","book":1,"number":47,"kind":"proposition","title":"勾股定理：直角三角形斜边平方等于两直角边平方和","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-11-35:euclid-1-48:explicit","id":"euclid-1-48","book":1,"number":48,"kind":"proposition","title":"勾股定理的逆命题","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-