-11-33:explicit","id":"euclid-11-33","book":11,"number":33,"kind":"proposition","title":"性质与证明：平行六面体与平行线与比例","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-12-8:euclid-11-28:explicit","id":"euclid-11-28","book":11,"number":28,"kind":"proposition","title":"性质与证明：平行六面体与平面与平行线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-12-8:euclid-12-7:explicit","id":"euclid-12-7","book":12,"number":7,"kind":"proposition","title":"三棱柱可以分成三个等体积棱锥","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-12-8:euclid-6-20:explicit","id":"euclid-6-20","book":6,"number":20,"kind":"proposition","title":"以三角形分相似之多边直线形则分数必等而相当之各三角形各相似其各相当两三角形…","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-12-8:euclid-5-12:explicit","id":"euclid-5-12","book":5,"number":12,"kind":"proposition","title":"性质与证明：比例与整数","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-12-12:euclid-12-8:explicit","id":"euclid-12-12","book":12,"number":12,"kind":"proposition","title":"性质与证明：圆柱与圆锥与直径","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-12-17:euclid-12-8:explicit","id":"euclid-12-17","book":12,"number":17,"kind":"proposition","title":"构造与求解：球与切线","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-solid","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
