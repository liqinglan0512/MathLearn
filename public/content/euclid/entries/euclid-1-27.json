provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-31:euclid-1-27:explicit","id":"euclid-1-31","book":1,"number":31,"kind":"proposition","title":"过已知点作已知直线的平行线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-33:euclid-1-27:explicit","id":"euclid-1-33","book":1,"number":33,"kind":"proposition","title":"连接两条相等平行线段所得线段仍相等平行","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-parallel","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
