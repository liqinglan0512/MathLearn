i_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_2.68","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:10.prop_2.68/","sourceLabel":"X. 23, Por."}}],"incomingEdges":[],"dependencies":[{"edgeId":"edge:euclid-10-68:euclid-10-39:explicit","id":"euclid-10-39","book":10,"number":39,"kind":"proposition","title":"性质与证明：不可公度量与可公度量与中项无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-68:euclid-5-11:explicit","id":"euclid-5-11","book":5,"number":11,"kind":"proposition","title":"比例相等的传递性","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-68:euclid-10-11:explicit","id":"euclid-10-11","book":10,"number":11,"kind":"proposition","title":"比例关系保持可公度与不可公度","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-68:euclid-5-16:explicit","id":"euclid-5-16","book":5,"number":16,"kind":"proposition","title":"比例的交错变换","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-68:euclid-5-18:explicit","id":"euclid-5-18","book":5,"number":18,"kind":"proposition","title":"分比与合比的转换","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-68:euclid-6-20:explicit","id":"euclid-6-20","book":6,"number":20,"kind":"proposition","title":"以三角形分相似之多边直线形则分数必等而相当之各三角形各相似其各相当两三角形…","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-68:euclid-10-23:explicit","id":"euclid-10-23","book":10,"number":23,"kind":"proposition","title":"性质与证明：可公度量与中项无理线段与线段","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-irrational","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
