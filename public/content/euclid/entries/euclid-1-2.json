s.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.2/","sourceLabel":"C.N. 3"}},{"id":"edge:euclid-1-2:euclid-1-cn-1:explicit","sourceContentId":"euclid-1-2","sourceBlockIds":["euclid-1-2.proof.7"],"targetContentId":"euclid-1-cn-1","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.2","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.2/","sourceLabel":"C.N. 1"}}],"incomingEdges":[{"id":"edge:euclid-1-3:euclid-1-2:explicit","sourceContentId":"euclid-1-3","sourceBlockIds":["euclid-1-3.proof.2"],"targetContentId":"euclid-1-2","type":"depends_on","provenance":{"kind":"explicit_source_reference","basis":"perseus_tei_ref","sourceUrn":"urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.3","sourceUrl":"https://scaife.perseus.org/reader/urn:cts:greekLit:tlg1799.tlg001.perseus-eng2:1.prop.3/","sourceLabel":"I. 2"}}],"dependencies":[{"edgeId":"edge:euclid-1-2:euclid-1-post-1:explicit","id":"euclid-1-post-1","book":1,"number":1,"kind":"postulate","title":"公设一：任意两点之间可以连成直线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-2:euclid-1-1:explicit","id":"euclid-1-1","book":1,"number":1,"kind":"proposition","title":"等边三角形的尺规作图","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-2:euclid-1-post-2:explicit","id":"euclid-1-post-2","book":1,"number":2,"kind":"postulate","title":"公设二：有限直线可以无限延长","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-2:euclid-1-post-3:explicit","id":"euclid-1-post-3","book":1,"number":3,"kind":"postulate","title":"公设三：给定圆心和半径可以作圆","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-2:euclid-1-cn-3:explicit","id":"euclid-1-cn-3","book":1,"number":3,"kind":"common-notion","title":"公理三：等量减等量，所得余量相等","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-1-2:euclid-1-cn-1:explicit","id":"euclid-1-cn-1","book":1,"number":1,"kind":"common-notion","title":"公理一：等于同一事物的事物彼此相等","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-1-3:euclid-1-2:explicit","id":"euclid-1-3","book":1,"number":3,"kind":"proposition","title":"从长线段截取与短线段相等的部分","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-triangle","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
