ance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-71:euclid-10-55:explicit","id":"euclid-10-55","book":10,"number":55,"kind":"proposition","title":"性质与证明：二项无理线段与中项无理线段与无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-71:euclid-10-def-9:explicit","id":"euclid-10-def-9","book":10,"number":9,"kind":"definition","title":"第五类二项无理线段","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-10-71:euclid-10-58:explicit","id":"euclid-10-58","book":10,"number":58,"kind":"proposition","title":"性质与证明：二项无理线段与中项无理线段与无理线段","provenance":"explicit_source_reference"}],"dependents":[],"visualization":{"level":"concept_illustration","rendererId":"concept-irrational","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
