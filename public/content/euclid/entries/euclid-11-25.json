cies":[{"edgeId":"edge:euclid-11-25:euclid-11-24:explicit","id":"euclid-11-24","book":11,"number":24,"kind":"proposition","title":"等量关系：平面与平行四边形与平行线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-11-25:euclid-5-def-5:explicit","id":"euclid-5-def-5","book":5,"number":5,"kind":"definition","title":"欧多克索斯比例定义：任意等倍数的比较","provenance":"explicit_source_reference"}],"dependents":[{"edgeId":"edge:euclid-11-31:euclid-11-25:explicit","id":"euclid-11-31","book":11,"number":31,"kind":"proposition","title":"等量关系：平行六面体与平行线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-11-32:euclid-11-25:explicit","id":"euclid-11-32","book":11,"number":32,"kind":"proposition","title":"性质与证明：平行六面体与平行线","provenance":"explicit_source_reference"},{"edgeId":"edge:euclid-11-34:euclid-11-25:explicit","id":"euclid-11-34","book":11,"number":34,"kind":"proposition","title":"等量关系：平行六面体与平行线与比例","provenance":"explicit_source_reference"}],"visualization":{"level":"concept_illustration","rendererId":"concept-solid","rationale":"The current renderer is selected by a broad geometry family and must not be presented as this proposition’s exact construction."},"sourceIssues":[]}
